{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StaticHit",
  "description": "A static analysis hit, normalised from a backend's SARIF or JSON output.",
  "type": "object",
  "properties": {
    "backend": {
      "description": "Backend name (one of the detector backends).",
      "type": "string"
    },
    "file": {
      "description": "Project-relative file with `/` separators.",
      "type": "string"
    },
    "line": {
      "description": "1-based line.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "message": {
      "description": "The backend's message, trimmed.",
      "type": "string"
    },
    "rule": {
      "description": "The backend's rule identifier.",
      "type": "string"
    }
  },
  "required": [
    "backend",
    "rule",
    "file",
    "line",
    "message"
  ]
}
