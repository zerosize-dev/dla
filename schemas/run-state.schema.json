{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RunState",
  "description": "`state.json`.",
  "type": "object",
  "properties": {
    "artifacts": {
      "description": "Artifact paths relative to the project root (artifact runs).",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget": {
      "description": "Time budget.",
      "$ref": "#/$defs/Budget"
    },
    "consent": {
      "description": "Consent, once given.",
      "anyOf": [
        {
          "$ref": "#/$defs/Consent"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "description": "Creation time.",
      "type": "string",
      "format": "date-time"
    },
    "dla_version": {
      "description": "Version of dla that created the run.",
      "type": "string"
    },
    "entry": {
      "description": "Entry path (older state files: repository).",
      "$ref": "#/$defs/EntryPath",
      "default": "repository"
    },
    "incomplete_reason": {
      "description": "Why the run is incomplete or aborted.",
      "type": [
        "string",
        "null"
      ]
    },
    "processes": {
      "description": "Processes DLA started.",
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/ProcessRecord"
      }
    },
    "project_root": {
      "description": "Absolute project root.",
      "type": "string"
    },
    "redaction_salt": {
      "description": "Random per-run salt (hex) for value redaction.",
      "type": "string"
    },
    "report": {
      "description": "The rendered report, once rendered.",
      "anyOf": [
        {
          "$ref": "#/$defs/ReportRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "description": "`YYYYMMDD-HHMMSS-xxxx` (UTC plus 4 hex).",
      "type": "string"
    },
    "schema_version": {
      "description": "Schema version.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "scope": {
      "description": "Investigation scope.",
      "anyOf": [
        {
          "$ref": "#/$defs/Scope"
        },
        {
          "type": "null"
        }
      ]
    },
    "session_id": {
      "description": "Host session ID, `unknown` if absent.",
      "type": "string"
    },
    "stage": {
      "description": "Current stage.",
      "$ref": "#/$defs/Stage"
    },
    "stages_passed": {
      "description": "Stages that passed `dla gate check --stage`, in the order they passed. Written only\nby a passing gate check.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Stage"
      }
    },
    "status": {
      "description": "Overall status.",
      "$ref": "#/$defs/RunStatus"
    },
    "stop_block_digest": {
      "description": "Digest (ledger length plus hash of the missing-item ids) of the last failing stop attempt.",
      "type": [
        "string",
        "null"
      ]
    },
    "stop_blocks": {
      "description": "Consecutive failing stop attempts with an unchanged ledger digest.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "worker_stages_passed": {
      "description": "The stages each worker passed with `dla --worker <name> gate check --stage <s>`. A\nworker's own checks never touch `stages_passed`: the read hook lets a subagent read\nthe archetype tables once its worker passed `classify` here.",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/$defs/Stage"
        }
      }
    },
    "worker_stop": {
      "description": "The same counter for each worker's SubagentStop hook, by worker name.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/StopCounter"
      }
    },
    "workers": {
      "description": "Workers registered by `dla run dispatch`.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/WorkerEntry"
      }
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "session_id",
    "project_root",
    "created_at",
    "dla_version",
    "stage",
    "status",
    "budget",
    "redaction_salt"
  ],
  "$defs": {
    "Budget": {
      "description": "Time budget.",
      "type": "object",
      "properties": {
        "deadline": {
          "description": "Start plus budget.",
          "type": "string",
          "format": "date-time"
        },
        "seconds": {
          "description": "Budget in seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "started_at": {
          "description": "Start of the budget.",
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "seconds",
        "started_at",
        "deadline"
      ]
    },
    "Consent": {
      "description": "Consent given for intrusive steps.",
      "type": "object",
      "properties": {
        "given_by": {
          "description": "Who gave it.",
          "$ref": "#/$defs/ConsentGiver"
        },
        "raw_values": {
          "description": "Whether raw values may appear in evidence.",
          "type": "boolean"
        },
        "recorded_at": {
          "description": "When it was recorded.",
          "type": "string",
          "format": "date-time"
        },
        "tiers": {
          "description": "Allowed intrusiveness tiers.",
          "type": "array",
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          }
        }
      },
      "required": [
        "tiers",
        "raw_values",
        "given_by",
        "recorded_at"
      ]
    },
    "ConsentGiver": {
      "description": "Who recorded the consent.",
      "oneOf": [
        {
          "description": "The user, interactively.",
          "type": "string",
          "const": "user"
        },
        {
          "description": "The runner, by policy.",
          "type": "string",
          "const": "runner"
        }
      ]
    },
    "EntryPath": {
      "description": "Which of the four entry paths a run takes.",
      "oneOf": [
        {
          "description": "A source repository (the default).",
          "type": "string",
          "const": "repository"
        },
        {
          "description": "A running process DLA did not start.",
          "type": "string",
          "const": "process"
        },
        {
          "description": "Captured artifacts only (heap dumps, profiles).",
          "type": "string",
          "const": "artifact"
        },
        {
          "description": "A symptom description without a target.",
          "type": "string",
          "const": "symptom"
        }
      ]
    },
    "ProcessKind": {
      "description": "Kind of process DLA started.",
      "oneOf": [
        {
          "description": "A test or workload harness.",
          "type": "string",
          "const": "harness"
        },
        {
          "description": "A development server.",
          "type": "string",
          "const": "dev-server"
        },
        {
          "description": "A container.",
          "type": "string",
          "const": "container"
        },
        {
          "description": "A profiler.",
          "type": "string",
          "const": "profiler"
        }
      ]
    },
    "ProcessRecord": {
      "description": "A process DLA started and must clean up.",
      "type": "object",
      "properties": {
        "cleanup": {
          "description": "Cleanup actions for an attached tool, in order (for example\n`remove /tmp/.java_pid123`).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "command": {
          "description": "Command line.",
          "type": "string"
        },
        "kind": {
          "description": "What it is.",
          "$ref": "#/$defs/ProcessKind"
        },
        "pid": {
          "description": "Process ID.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "role": {
          "description": "Whether DLA started the process or attached to it (older records: started).",
          "$ref": "#/$defs/ProcessRole",
          "default": "started"
        },
        "start_time": {
          "description": "Platform start time, to disambiguate PID reuse.",
          "type": [
            "string",
            "null"
          ]
        },
        "started_at": {
          "description": "When it started.",
          "type": "string",
          "format": "date-time"
        },
        "stopped_at": {
          "description": "When it stopped.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "worker": {
          "description": "The worker that registered it, in worker mode.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "pid",
        "kind",
        "command",
        "started_at"
      ]
    },
    "ProcessRole": {
      "description": "How DLA came to know a process.",
      "oneOf": [
        {
          "description": "DLA started it and may stop it.",
          "type": "string",
          "const": "started"
        },
        {
          "description": "DLA attached a tool to a process it did not start; it never kills the target.",
          "type": "string",
          "const": "attached"
        }
      ]
    },
    "ReportRef": {
      "description": "The rendered report, pinned by hash.",
      "type": "object",
      "properties": {
        "path": {
          "description": "Path of the report relative to the run directory.",
          "type": "string"
        },
        "rendered_at": {
          "description": "When it was rendered.",
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "description": "SHA-256 of the report bytes, lowercase hex.",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "rendered_at"
      ]
    },
    "RunStatus": {
      "description": "Overall status of a run.",
      "oneOf": [
        {
          "description": "In progress.",
          "type": "string",
          "const": "active"
        },
        {
          "description": "Finished with nothing outstanding.",
          "type": "string",
          "const": "complete"
        },
        {
          "description": "Stopped with outstanding items.",
          "type": "string",
          "const": "incomplete"
        },
        {
          "description": "Abandoned.",
          "type": "string",
          "const": "aborted"
        }
      ]
    },
    "Scope": {
      "description": "What the investigation covers.",
      "type": "object",
      "properties": {
        "excluded": {
          "description": "Excluded paths.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "description": "Repository, module or service.",
          "$ref": "#/$defs/ScopeKind"
        },
        "path": {
          "description": "Path of the module or service (the repository root for `repository`).",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "path"
      ]
    },
    "ScopeKind": {
      "description": "What a scope covers.",
      "oneOf": [
        {
          "description": "The whole repository.",
          "type": "string",
          "const": "repository"
        },
        {
          "description": "One module.",
          "type": "string",
          "const": "module"
        },
        {
          "description": "One service.",
          "type": "string",
          "const": "service"
        }
      ]
    },
    "Stage": {
      "description": "Stage of the investigation.",
      "oneOf": [
        {
          "description": "Collecting the target, scope and symptom.",
          "type": "string",
          "const": "intake"
        },
        {
          "description": "Probing the environment.",
          "type": "string",
          "const": "probe"
        },
        {
          "description": "Sweeping for candidates.",
          "type": "string",
          "const": "sweep"
        },
        {
          "description": "Classifying candidates.",
          "type": "string",
          "const": "classify"
        },
        {
          "description": "Confirming growth.",
          "type": "string",
          "const": "confirm"
        },
        {
          "description": "Attributing to a site and holder.",
          "type": "string",
          "const": "attribute"
        },
        {
          "description": "Ruling out alternatives.",
          "type": "string",
          "const": "rule_out"
        },
        {
          "description": "Applying the completeness gate.",
          "type": "string",
          "const": "gate"
        },
        {
          "description": "Rendering the report.",
          "type": "string",
          "const": "report"
        }
      ]
    },
    "StopCounter": {
      "description": "Consecutive failing stop attempts with an unchanged digest.",
      "type": "object",
      "properties": {
        "blocks": {
          "description": "Failing stop attempts in a row with this digest.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "digest": {
          "description": "Digest of the last failing stop attempt.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "blocks"
      ]
    },
    "WorkerEntry": {
      "description": "One worker registered by `dla run dispatch`.",
      "type": "object",
      "properties": {
        "deadline": {
          "description": "Absolute deadline.",
          "type": "string",
          "format": "date-time"
        },
        "name": {
          "description": "Worker name (the runtime name, for example `jvm`).",
          "type": "string"
        },
        "runtime": {
          "description": "Runtime the worker covers.",
          "type": "string"
        },
        "share_secs": {
          "description": "Its share of the remaining budget, in seconds.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "slice": {
          "description": "Slice file name inside the run directory: `ledger.<name>.jsonl`.",
          "type": "string"
        },
        "stalled": {
          "description": "The worker made three failing stop attempts in a row with no ledger change and the\nSubagentStop gate let it stop; merge turns its unfinished work into an open item.",
          "type": "boolean"
        },
        "started_at": {
          "description": "When its slice started, once it has.",
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "status": {
          "description": "Lifecycle status.",
          "$ref": "#/$defs/WorkerStatus"
        }
      },
      "required": [
        "name",
        "runtime",
        "share_secs",
        "deadline",
        "status",
        "slice"
      ]
    },
    "WorkerStatus": {
      "description": "Lifecycle of one worker.",
      "oneOf": [
        {
          "description": "Registered by `dla run dispatch`, nothing written yet.",
          "type": "string",
          "const": "registered"
        },
        {
          "description": "Its slice has been started.",
          "type": "string",
          "const": "running"
        },
        {
          "description": "It wrote `slice_done`.",
          "type": "string",
          "const": "done"
        },
        {
          "description": "It stopped without `slice_done`.",
          "type": "string",
          "const": "killed"
        },
        {
          "description": "Its deadline passed before `slice_done`.",
          "type": "string",
          "const": "over-budget"
        }
      ]
    }
  }
}
