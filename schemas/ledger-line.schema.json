{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LedgerLine",
  "description": "One line of `ledger.jsonl`.\n\n`worker` is the key of the worker a line belongs to. `dla ledger merge` sets it on the\nlines it copies from a slice. The slice records (`slice_started`, `slice_done`,\n`slice_merged`) carry the same key in their own body; on the wire it appears once,\nand reading such a line sets both.",
  "type": "object",
  "properties": {
    "schema_version": {
      "description": "Schema version of this line.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "seq": {
      "description": "1-based sequence number; consecutive.",
      "type": "integer",
      "format": "uint64",
      "minimum": 0
    },
    "ts": {
      "description": "When the line was appended (RFC 3339, UTC).",
      "type": "string",
      "format": "date-time"
    },
    "worker": {
      "description": "The worker whose slice the line came from; set by `dla ledger merge` (schema 3).",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "oneOf": [
    {
      "description": "A tool result.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "evidence"
        }
      },
      "$ref": "#/$defs/EvidenceRecord",
      "required": [
        "type"
      ]
    },
    {
      "description": "A new finding, in state `candidate`.",
      "type": "object",
      "properties": {
        "finding": {
          "description": "The finding.",
          "$ref": "#/$defs/Finding"
        },
        "type": {
          "type": "string",
          "const": "finding_added"
        }
      },
      "required": [
        "type",
        "finding"
      ]
    },
    {
      "description": "A finding changed state.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "transition"
        }
      },
      "$ref": "#/$defs/Transition",
      "required": [
        "type"
      ]
    },
    {
      "description": "An open item was raised.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "open_item"
        }
      },
      "$ref": "#/$defs/OpenItem",
      "required": [
        "type"
      ]
    },
    {
      "description": "An open item was closed.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "open_item_resolved"
        }
      },
      "$ref": "#/$defs/OpenItemResolved",
      "required": [
        "type"
      ]
    },
    {
      "description": "A checklist item was answered.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "checklist_answer"
        }
      },
      "$ref": "#/$defs/ChecklistAnswer",
      "required": [
        "type"
      ]
    },
    {
      "description": "Writers and removers were recorded for a finding (no state change).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "finding_annotated"
        }
      },
      "$ref": "#/$defs/FindingAnnotation",
      "required": [
        "type"
      ]
    },
    {
      "description": "A worker's slice began (first line of every `ledger.<worker>.jsonl`).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "slice_started"
        }
      },
      "$ref": "#/$defs/SliceStarted",
      "required": [
        "type"
      ]
    },
    {
      "description": "A worker finished its slice.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "slice_done"
        }
      },
      "$ref": "#/$defs/SliceDone",
      "required": [
        "type"
      ]
    },
    {
      "description": "`dla ledger merge` copied lines of a slice into this ledger.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "slice_merged"
        }
      },
      "$ref": "#/$defs/SliceMerged",
      "required": [
        "type"
      ]
    },
    {
      "description": "Two workers' findings are the same (site, holder): one is a duplicate of the other.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "finding_merged"
        }
      },
      "$ref": "#/$defs/FindingMerged",
      "required": [
        "type"
      ]
    },
    {
      "description": "An independent verifier looked at a finding's bundle.",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "verification"
        }
      },
      "$ref": "#/$defs/Verification",
      "required": [
        "type"
      ]
    },
    {
      "description": "A finding got an archetype label (schema 6).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "finding_labeled"
        }
      },
      "$ref": "#/$defs/FindingLabeled",
      "required": [
        "type"
      ]
    },
    {
      "description": "A finding got a structured explanation (schema 6).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "finding_explained"
        }
      },
      "$ref": "#/$defs/FindingExplained",
      "required": [
        "type"
      ]
    },
    {
      "description": "`dla run reseal` re-sealed protected files after an out-of-band change (schema 6).",
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "integrity_resealed"
        }
      },
      "$ref": "#/$defs/IntegrityResealed",
      "required": [
        "type"
      ]
    }
  ],
  "required": [
    "schema_version",
    "seq",
    "ts"
  ],
  "$defs": {
    "AnswerStatus": {
      "description": "How completely a checklist item was answered.",
      "oneOf": [
        {
          "description": "Fully answered.",
          "type": "string",
          "const": "answered"
        },
        {
          "description": "Partly answered.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "Not answerable now; carries reason and remedy.",
          "type": "string",
          "const": "unresolved"
        }
      ]
    },
    "Authority": {
      "description": "How strongly a piece of evidence was obtained.",
      "oneOf": [
        {
          "description": "Read from source or configuration without running anything.",
          "type": "string",
          "const": "static"
        },
        {
          "description": "Produced by a test or targeted experiment.",
          "type": "string",
          "const": "test"
        },
        {
          "description": "Observed on a live process.",
          "type": "string",
          "const": "live"
        },
        {
          "description": "Read from a captured dump.",
          "type": "string",
          "const": "dump"
        }
      ]
    },
    "ChecklistAnswer": {
      "description": "A `checklist_answer` ledger record body.",
      "type": "object",
      "properties": {
        "evidence": {
          "description": "Supporting evidence; at least one unless `unresolved`.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceId"
          }
        },
        "item": {
          "description": "Checklist item ID.",
          "type": "string"
        },
        "note": {
          "description": "Free-text note.",
          "type": [
            "string",
            "null"
          ]
        },
        "reason": {
          "description": "Required with `unresolved`.",
          "anyOf": [
            {
              "$ref": "#/$defs/UnresolvedReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "remedy": {
          "description": "Required with `unresolved`.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "Answer status.",
          "$ref": "#/$defs/AnswerStatus"
        }
      },
      "required": [
        "item",
        "status"
      ]
    },
    "CoverageStatus": {
      "description": "How much of the subject the evidence covers.",
      "oneOf": [
        {
          "description": "The whole subject was examined.",
          "type": "string",
          "const": "complete"
        },
        {
          "description": "Part of the subject was examined.",
          "type": "string",
          "const": "partial"
        },
        {
          "description": "It is not known how much was examined.",
          "type": "string",
          "const": "unknown"
        }
      ]
    },
    "EvidenceCoverage": {
      "description": "Coverage of one evidence record.",
      "type": "object",
      "properties": {
        "examined": {
          "description": "How many units were examined.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "status": {
          "description": "Overall status.",
          "$ref": "#/$defs/CoverageStatus"
        },
        "total": {
          "description": "How many units exist.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        }
      },
      "required": [
        "status"
      ]
    },
    "EvidenceId": {
      "type": "string",
      "pattern": "^([a-z0-9-]+/)?E[1-9][0-9]*$"
    },
    "EvidenceKind": {
      "description": "The closed set of evidence kinds.",
      "oneOf": [
        {
          "description": "Run configuration captured at init.",
          "type": "string",
          "const": "run-config"
        },
        {
          "description": "Result of probing the environment.",
          "type": "string",
          "const": "probe"
        },
        {
          "description": "A static detector hit.",
          "type": "string",
          "const": "static-hit"
        },
        {
          "description": "A holder found by a census.",
          "type": "string",
          "const": "census-holder"
        },
        {
          "description": "A workload execution record.",
          "type": "string",
          "const": "workload"
        },
        {
          "description": "A growth measurement series.",
          "type": "string",
          "const": "growth-series"
        },
        {
          "description": "A per-unit count series.",
          "type": "string",
          "const": "unit-count-series"
        },
        {
          "description": "A retention path to a root.",
          "type": "string",
          "const": "retention-path"
        },
        {
          "description": "An allocation stack.",
          "type": "string",
          "const": "alloc-stack"
        },
        {
          "description": "A before/after histogram difference.",
          "type": "string",
          "const": "histogram-diff"
        },
        {
          "description": "A profile of blocked stacks.",
          "type": "string",
          "const": "blocked-stack-profile"
        },
        {
          "description": "Objects unreachable at exit.",
          "type": "string",
          "const": "unreachable-at-exit"
        },
        {
          "description": "Objects that should be dead but are not.",
          "type": "string",
          "const": "should-be-dead"
        },
        {
          "description": "An experiment that separates two hypotheses.",
          "type": "string",
          "const": "discriminator"
        },
        {
          "description": "A change made to the target to test a cause.",
          "type": "string",
          "const": "intervention"
        },
        {
          "description": "A measurement outside the heap.",
          "type": "string",
          "const": "non-heap"
        },
        {
          "description": "Growth left unattributed.",
          "type": "string",
          "const": "residual"
        },
        {
          "description": "Files captured from a live process by an attached tool (heap dump, profile).",
          "type": "string",
          "const": "artifact"
        }
      ]
    },
    "EvidenceRecord": {
      "description": "One tool result.",
      "type": "object",
      "properties": {
        "authority": {
          "description": "How it was obtained.",
          "$ref": "#/$defs/Authority"
        },
        "coverage": {
          "description": "How much of the subject it covers.",
          "$ref": "#/$defs/EvidenceCoverage",
          "default": {
            "status": "unknown"
          }
        },
        "evidence_id": {
          "description": "Identifier, allocated by the ledger.",
          "$ref": "#/$defs/EvidenceId"
        },
        "kind": {
          "description": "What it is.",
          "$ref": "#/$defs/EvidenceKind"
        },
        "limitations": {
          "description": "Known limits of this evidence.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "raw": {
          "description": "Path, relative to the run directory, of the full output.",
          "type": [
            "string",
            "null"
          ]
        },
        "result": {
          "description": "The bounded result (serialized size at most [`MAX_RESULT_BYTES`])."
        },
        "source": {
          "description": "Where it came from.",
          "$ref": "#/$defs/Source"
        },
        "tool": {
          "description": "Which backend produced it.",
          "$ref": "#/$defs/Tool"
        },
        "unknowns": {
          "description": "Open questions.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Unknown"
          }
        }
      },
      "required": [
        "evidence_id",
        "source",
        "tool",
        "authority",
        "kind",
        "result"
      ]
    },
    "Explanation": {
      "description": "Free-text explanation with its epistemic tag.",
      "type": "object",
      "properties": {
        "tag": {
          "description": "Observed or inferred.",
          "$ref": "#/$defs/ExplanationTag"
        },
        "text": {
          "description": "The explanation.",
          "type": "string"
        }
      },
      "required": [
        "text",
        "tag"
      ]
    },
    "ExplanationTag": {
      "description": "Whether an explanation was seen or reasoned.",
      "oneOf": [
        {
          "description": "Directly observed.",
          "type": "string",
          "const": "observed"
        },
        {
          "description": "Inferred from observations.",
          "type": "string",
          "const": "inferred"
        }
      ]
    },
    "Finding": {
      "description": "One hypothesis about a leak and everything known about it.",
      "type": "object",
      "properties": {
        "amplifiers": {
          "description": "Factors that worsen the leak.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "archetype": {
          "description": "Assigned archetype; only `dla ledger label` changes it.",
          "type": "string",
          "default": "UNCLASSIFIED"
        },
        "contradicts": {
          "description": "Evidence contradicting the finding.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceId"
          }
        },
        "explanation": {
          "description": "Explanation with its tag.",
          "anyOf": [
            {
              "$ref": "#/$defs/Explanation"
            },
            {
              "type": "null"
            }
          ]
        },
        "holder": {
          "description": "What holds the memory.",
          "anyOf": [
            {
              "$ref": "#/$defs/Holder"
            },
            {
              "type": "null"
            }
          ]
        },
        "hypothesis": {
          "description": "The cause this hypothesis proposes (on a sibling).",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Identifier.",
          "$ref": "#/$defs/FindingId"
        },
        "locus": {
          "description": "Where the leak lives.",
          "anyOf": [
            {
              "$ref": "#/$defs/Locus"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "description": "How the finding was raised.",
          "$ref": "#/$defs/Origin"
        },
        "owner": {
          "description": "Owning field or container on the retention path.",
          "type": [
            "string",
            "null"
          ]
        },
        "parent": {
          "description": "Parent finding of a sibling hypothesis.",
          "anyOf": [
            {
              "$ref": "#/$defs/FindingId"
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "description": "Why unresolved or static-only; required exactly for those states.",
          "anyOf": [
            {
              "$ref": "#/$defs/UnresolvedReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "refute_if": {
          "description": "The result that would refute this hypothesis.",
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "description": "Memory region.",
          "anyOf": [
            {
              "$ref": "#/$defs/Region"
            },
            {
              "type": "null"
            }
          ]
        },
        "remedy": {
          "description": "What would unblock it; non-empty whenever `reason` is set.",
          "type": [
            "string",
            "null"
          ]
        },
        "repair_class": {
          "description": "Class of repair.",
          "anyOf": [
            {
              "$ref": "#/$defs/RepairClass"
            },
            {
              "type": "null"
            }
          ]
        },
        "shape": {
          "description": "Growth shape.",
          "anyOf": [
            {
              "$ref": "#/$defs/Shape"
            },
            {
              "type": "null"
            }
          ]
        },
        "siblings": {
          "description": "Sibling hypotheses; maintained by the ledger.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/FindingId"
          }
        },
        "site": {
          "description": "`file:line`.",
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "description": "Lifecycle state.",
          "$ref": "#/$defs/FindingState"
        },
        "suggested_archetype": {
          "description": "A tag suggesting an archetype; never filters anything.",
          "type": [
            "string",
            "null"
          ]
        },
        "supports": {
          "description": "Evidence supporting the finding.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceId"
          }
        }
      },
      "required": [
        "id",
        "state",
        "origin"
      ]
    },
    "FindingAnnotation": {
      "description": "Writers and removers found for a finding's holder, and its holder, owner, region and\nsite when none is recorded yet. It does not change the finding's state; the report lists\nthe sites under the finding.",
      "type": "object",
      "properties": {
        "evidence": {
          "description": "Growth evidence that backs a change of a holder already set (schema 5): a heap-graph\n`growth-series` with a passing column tied to the finding whose `holder_kind` is\n`holder`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvidenceId"
          }
        },
        "finding": {
          "description": "The finding.",
          "$ref": "#/$defs/FindingId"
        },
        "holder": {
          "description": "What holds the memory; applied only when the finding has no holder yet.",
          "anyOf": [
            {
              "$ref": "#/$defs/Holder"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "description": "Free-text note.",
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "description": "Owning field or container; applied only when the finding has no owner yet.",
          "type": [
            "string",
            "null"
          ]
        },
        "region": {
          "description": "Memory region; applied only when the finding has no region yet.",
          "anyOf": [
            {
              "$ref": "#/$defs/Region"
            },
            {
              "type": "null"
            }
          ]
        },
        "removers": {
          "description": "`file:line` sites that remove from the holder.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "replaced_holder": {
          "description": "The holder this annotation replaced; written by the ledger, an audit trail.",
          "anyOf": [
            {
              "$ref": "#/$defs/Holder"
            },
            {
              "type": "null"
            }
          ]
        },
        "site": {
          "description": "`file:line` of the finding; applied only when the finding has no site yet.",
          "type": [
            "string",
            "null"
          ]
        },
        "writers": {
          "description": "`file:line` sites that add to the holder.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "finding"
      ]
    },
    "FindingExplained": {
      "description": "A structured explanation of a leak (`dla ledger explain`).",
      "type": "object",
      "properties": {
        "adds": {
          "description": "`file:line` sites that add to the holder.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "description": "Evidence that shows the pairing, required with `observed`.",
          "anyOf": [
            {
              "$ref": "#/$defs/EvidenceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "finding": {
          "description": "The finding.",
          "$ref": "#/$defs/FindingId"
        },
        "removal": {
          "description": "What happens to the items afterwards.",
          "$ref": "#/$defs/RemovalClaim"
        },
        "remover": {
          "description": "`file:line` of the remover, for `conditional`, `wrong-key` and `unreachable`.",
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "description": "Observed or inferred.",
          "$ref": "#/$defs/ExplanationTag"
        },
        "text": {
          "description": "The explanation text.",
          "type": "string"
        }
      },
      "required": [
        "finding",
        "tag",
        "removal",
        "text"
      ]
    },
    "FindingId": {
      "type": "string",
      "pattern": "^([a-z0-9-]+/)?F[1-9][0-9]*(\\.n[1-9][0-9]*)?$"
    },
    "FindingLabeled": {
      "description": "An archetype label for a confirmed or strong finding (`dla ledger label`).",
      "type": "object",
      "properties": {
        "entry_sha256": {
          "description": "SHA-256 (lowercase hex) of the archetype entry used; empty for `UNCLASSIFIED`.",
          "type": "string",
          "default": ""
        },
        "finding": {
          "description": "The finding.",
          "$ref": "#/$defs/FindingId"
        },
        "label": {
          "description": "An archetype ID (`L-*`, `N-*`) or `UNCLASSIFIED`.",
          "type": "string"
        },
        "note": {
          "description": "Why nothing fits (`UNCLASSIFIED`) or any other note.",
          "type": [
            "string",
            "null"
          ]
        },
        "previous": {
          "description": "The label before this line (audit trail).",
          "type": "string"
        },
        "region_mismatch": {
          "description": "The finding's region is not among the archetype's regions (a warning, not a refusal).",
          "type": "boolean",
          "default": false
        },
        "satisfied": {
          "description": "The met `requires` alternative and its evidence; empty for `UNCLASSIFIED`.",
          "$ref": "#/$defs/LabelSatisfied",
          "default": {
            "evidence": [],
            "kinds": []
          }
        }
      },
      "required": [
        "finding",
        "label",
        "previous"
      ]
    },
    "FindingMerged": {
      "description": "Replay semantics: the duplicate is excluded from the counts and the report's finding\nlist, and its supporting evidence is added to the canonical finding.",
      "type": "object",
      "properties": {
        "canonical": {
          "description": "The finding that stays.",
          "$ref": "#/$defs/FindingId"
        },
        "duplicate": {
          "description": "The finding of another worker with the same site and holder.",
          "$ref": "#/$defs/FindingId"
        }
      },
      "required": [
        "canonical",
        "duplicate"
      ]
    },
    "FindingState": {
      "description": "Lifecycle state of a finding.",
      "oneOf": [
        {
          "description": "Raised, not yet tested.",
          "type": "string",
          "const": "candidate"
        },
        {
          "description": "A test is in progress.",
          "type": "string",
          "const": "under_test"
        },
        {
          "description": "Growth, site and holder established.",
          "type": "string",
          "const": "confirmed"
        },
        {
          "description": "Independently corroborated.",
          "type": "string",
          "const": "strong"
        },
        {
          "description": "Ruled out by a discriminator.",
          "type": "string",
          "const": "refuted"
        },
        {
          "description": "Seen statically, never exercised.",
          "type": "string",
          "const": "suspected_static_only"
        },
        {
          "description": "Left open, with a reason and a remedy.",
          "type": "string",
          "const": "unresolved"
        }
      ]
    },
    "Holder": {
      "description": "What holds the leaked memory.",
      "oneOf": [
        {
          "description": "A static or global variable.",
          "type": "string",
          "const": "static/global"
        },
        {
          "description": "A registration table (listeners, callbacks).",
          "type": "string",
          "const": "registration-table"
        },
        {
          "description": "A field of a container object.",
          "type": "string",
          "const": "container-field"
        },
        {
          "description": "Thread-local storage.",
          "type": "string",
          "const": "thread-local"
        },
        {
          "description": "A blocked stack.",
          "type": "string",
          "const": "blocked-stack"
        },
        {
          "description": "A closure or continuation.",
          "type": "string",
          "const": "closure/continuation"
        },
        {
          "description": "A native handle or global reference.",
          "type": "string",
          "const": "native-handle/global-ref"
        },
        {
          "description": "A reference cycle only.",
          "type": "string",
          "const": "cycle-only"
        }
      ]
    },
    "IntegrityResealed": {
      "description": "`dla run reseal`: protected files were changed outside `dla` and sealed again.",
      "type": "object",
      "properties": {
        "files": {
          "description": "Protected files (names relative to the run directory) that were sealed again.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "description": "Why, in the operator's words.",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ]
    },
    "LabelSatisfied": {
      "description": "The proof a label was accepted on: the inner set of the archetype's `requires` that was\nmet and the evidence that met it. Replay re-checks this record and never reads `data/`.",
      "type": "object",
      "properties": {
        "evidence": {
          "description": "Evidence records that carry those kinds.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceId"
          }
        },
        "kinds": {
          "description": "Evidence kinds of the met alternative (wire spelling, e.g. `unit-count-series`).",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "Locus": {
      "description": "Where the leak lives.",
      "oneOf": [
        {
          "description": "Application code.",
          "type": "string",
          "const": "app"
        },
        {
          "description": "A dependency.",
          "type": "string",
          "const": "dependency"
        },
        {
          "description": "The language runtime.",
          "type": "string",
          "const": "runtime"
        }
      ]
    },
    "OpenItem": {
      "description": "Something left to do.",
      "type": "object",
      "properties": {
        "finding": {
          "description": "Finding it relates to.",
          "anyOf": [
            {
              "$ref": "#/$defs/FindingId"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "Identifier.",
          "$ref": "#/$defs/OpenItemId"
        },
        "opened_by": {
          "description": "Who opened it.",
          "type": "string"
        },
        "text": {
          "description": "What is open.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "opened_by"
      ]
    },
    "OpenItemId": {
      "type": "string",
      "pattern": "^([a-z0-9-]+/)?O[1-9][0-9]*$"
    },
    "OpenItemResolved": {
      "description": "Closes an open item.",
      "type": "object",
      "properties": {
        "id": {
          "description": "The open item.",
          "$ref": "#/$defs/OpenItemId"
        },
        "resolution": {
          "description": "How it was closed.",
          "$ref": "#/$defs/Resolution"
        }
      },
      "required": [
        "id",
        "resolution"
      ]
    },
    "Origin": {
      "type": "string",
      "pattern": "^(census|growth-series|archetype-row|correlation|residual|verifier|hypothesis|detector:[^\\s:/]+/\\S+|known-leak:\\S+)$"
    },
    "Region": {
      "description": "Which memory region grows.",
      "oneOf": [
        {
          "description": "The managed heap.",
          "type": "string",
          "const": "heap"
        },
        {
          "description": "Native memory outside the managed heap.",
          "type": "string",
          "const": "off-heap"
        },
        {
          "description": "Runtime-internal non-heap memory.",
          "type": "string",
          "const": "non-heap"
        }
      ]
    },
    "RemovalClaim": {
      "description": "What the explanation says about removal of the retained items.",
      "oneOf": [
        {
          "description": "No code removes them.",
          "type": "string",
          "const": "never"
        },
        {
          "description": "A search found no remover (the census is heuristic).",
          "type": "string",
          "const": "not-found"
        },
        {
          "description": "A remover exists and runs only under a condition.",
          "type": "string",
          "const": "conditional"
        },
        {
          "description": "A remover exists and uses another key.",
          "type": "string",
          "const": "wrong-key"
        },
        {
          "description": "A remover exists and is never reached.",
          "type": "string",
          "const": "unreachable"
        }
      ]
    },
    "RepairClass": {
      "description": "Class of repair.",
      "oneOf": [
        {
          "description": "Release on the regular path.",
          "type": "string",
          "const": "release-regular"
        },
        {
          "description": "Release on the exceptional path.",
          "type": "string",
          "const": "release-exceptional"
        },
        {
          "description": "Remove the entry.",
          "type": "string",
          "const": "remove-entry"
        },
        {
          "description": "Bound or evict.",
          "type": "string",
          "const": "bound/evict"
        },
        {
          "description": "Deregister.",
          "type": "string",
          "const": "deregister"
        },
        {
          "description": "Stop or cancel.",
          "type": "string",
          "const": "stop/cancel"
        },
        {
          "description": "Clear the reference.",
          "type": "string",
          "const": "clear-reference"
        },
        {
          "description": "Restructure synchronisation.",
          "type": "string",
          "const": "restructure-sync"
        },
        {
          "description": "Return ownership.",
          "type": "string",
          "const": "return-ownership"
        }
      ]
    },
    "Resolution": {
      "description": "How an open item was closed.",
      "oneOf": [
        {
          "description": "Left unresolved with a reason and a remedy.",
          "type": "object",
          "properties": {
            "unresolved": {
              "type": "object",
              "properties": {
                "reason": {
                  "description": "Why.",
                  "$ref": "#/$defs/UnresolvedReason"
                },
                "remedy": {
                  "description": "What would resolve it.",
                  "type": "string"
                }
              },
              "required": [
                "reason",
                "remedy"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "unresolved"
          ]
        },
        {
          "description": "Covered by a new hypothesis.",
          "type": "object",
          "properties": {
            "hypothesis": {
              "$ref": "#/$defs/FindingId"
            }
          },
          "additionalProperties": false,
          "required": [
            "hypothesis"
          ]
        }
      ]
    },
    "Shape": {
      "description": "Shape of the growth curve.",
      "oneOf": [
        {
          "description": "Steady growth.",
          "type": "string",
          "const": "steady"
        },
        {
          "description": "Step-wise growth.",
          "type": "string",
          "const": "stair"
        },
        {
          "description": "Transient spike.",
          "type": "string",
          "const": "spike"
        },
        {
          "description": "Growth that levels off.",
          "type": "string",
          "const": "plateau"
        }
      ]
    },
    "SliceDone": {
      "description": "The last line of a finished slice.",
      "type": "object",
      "properties": {
        "open": {
          "description": "IDs of the slice's findings and open items that have no disposition.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "worker": {
          "description": "The worker.",
          "type": "string"
        }
      },
      "required": [
        "worker"
      ]
    },
    "SliceMerged": {
      "description": "Written by `dla ledger merge` after it copied lines of a slice.",
      "type": "object",
      "properties": {
        "done": {
          "description": "True when the merged lines include `slice_done`.",
          "type": "boolean"
        },
        "lines": {
          "description": "Slice lines merged so far, in total (a re-run appends only lines after this).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "sha256": {
          "description": "SHA-256 (lowercase hex) of the slice bytes those lines occupy.",
          "type": "string"
        },
        "torn_tail": {
          "description": "True when a torn final line was dropped.",
          "type": "boolean"
        },
        "worker": {
          "description": "The worker.",
          "type": "string"
        }
      },
      "required": [
        "worker",
        "lines",
        "sha256",
        "torn_tail",
        "done"
      ]
    },
    "SliceStarted": {
      "description": "The first line of a worker slice.",
      "type": "object",
      "properties": {
        "base_seq": {
          "description": "Length of the main ledger when the slice began: the slice may cite main IDs\ncreated by lines up to this one.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "deadline": {
          "description": "The worker's deadline (the run deadline when it was not registered).",
          "type": "string",
          "format": "date-time"
        },
        "runtime": {
          "description": "The runtime it covers (the worker name when it was not registered).",
          "type": "string"
        },
        "worker": {
          "description": "The worker.",
          "type": "string"
        }
      },
      "required": [
        "worker",
        "runtime",
        "base_seq",
        "deadline"
      ]
    },
    "Source": {
      "description": "Where a piece of evidence came from.",
      "oneOf": [
        {
          "description": "A file on disk.",
          "type": "object",
          "properties": {
            "artifact": {
              "type": "object",
              "properties": {
                "path": {
                  "description": "Path of the artifact.",
                  "type": "string"
                },
                "sha256": {
                  "description": "SHA-256 of its contents, lowercase hex.",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "artifact"
          ]
        },
        {
          "description": "A running process.",
          "type": "object",
          "properties": {
            "process": {
              "type": "object",
              "properties": {
                "pid": {
                  "description": "Process ID.",
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "start_time": {
                  "description": "Process start time (platform string) to disambiguate PID reuse.",
                  "type": "string"
                }
              },
              "required": [
                "pid",
                "start_time"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "process"
          ]
        },
        {
          "description": "A source repository.",
          "type": "object",
          "properties": {
            "repo": {
              "type": "object",
              "properties": {
                "commit": {
                  "description": "Commit hash, or a project path when no commit is readable.",
                  "type": "string"
                },
                "path": {
                  "description": "Path inside the repository.",
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "commit"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "repo"
          ]
        }
      ]
    },
    "Tool": {
      "description": "The backend that produced the evidence.",
      "type": "object",
      "properties": {
        "name": {
          "description": "Backend name.",
          "type": "string"
        },
        "version": {
          "description": "Backend version.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "Transition": {
      "description": "A state change of a finding.",
      "type": "object",
      "properties": {
        "by": {
          "description": "The dla command that made the move.",
          "type": "string"
        },
        "evidence": {
          "description": "Evidence cited by the move: added to `contradicts` for `refuted`, to\n`supports` otherwise.",
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceId"
          }
        },
        "finding": {
          "description": "The finding.",
          "$ref": "#/$defs/FindingId"
        },
        "from": {
          "description": "State before; must match the replayed state.",
          "$ref": "#/$defs/FindingState"
        },
        "reason": {
          "description": "Required with `unresolved` and `suspected_static_only`.",
          "anyOf": [
            {
              "$ref": "#/$defs/UnresolvedReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "remedy": {
          "description": "Required with a reason.",
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "description": "State after.",
          "$ref": "#/$defs/FindingState"
        }
      },
      "required": [
        "finding",
        "from",
        "to",
        "by"
      ]
    },
    "Unknown": {
      "description": "A question the evidence leaves open and how to answer it.",
      "type": "object",
      "properties": {
        "question": {
          "description": "What is not known.",
          "type": "string"
        },
        "resolve_by": {
          "description": "What would resolve it.",
          "type": "string"
        }
      },
      "required": [
        "question",
        "resolve_by"
      ]
    },
    "UnresolvedReason": {
      "description": "Why a finding could not be resolved.",
      "oneOf": [
        {
          "description": "The suspected path was never exercised.",
          "type": "string",
          "const": "not_exercised"
        },
        {
          "description": "No harness exists to exercise it.",
          "type": "string",
          "const": "no_harness"
        },
        {
          "description": "The needed environment is unavailable.",
          "type": "string",
          "const": "env_unavailable"
        },
        {
          "description": "The project does not build.",
          "type": "string",
          "const": "build_fails"
        },
        {
          "description": "The user declined a privileged step.",
          "type": "string",
          "const": "privilege_declined"
        },
        {
          "description": "A required tool is missing.",
          "type": "string",
          "const": "tool_missing"
        },
        {
          "description": "The time budget ran out.",
          "type": "string",
          "const": "time_budget"
        }
      ]
    },
    "Verification": {
      "description": "What an independent verifier concluded from a finding's evidence bundle alone.",
      "type": "object",
      "properties": {
        "agrees_holder": {
          "description": "The verifier's holder is the finding's.",
          "type": "boolean"
        },
        "agrees_label": {
          "description": "The verifier's label is the finding's (schema 6); `None` when archetypes were off or\nthe line predates the field.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "agrees_site": {
          "description": "The verifier's site is the finding's (same file, line within 3), or both are none.",
          "type": "boolean"
        },
        "bundle": {
          "description": "SHA-256 of the bundle manifest the verifier read.",
          "type": "string"
        },
        "finding": {
          "description": "The finding.",
          "$ref": "#/$defs/FindingId"
        },
        "holder": {
          "description": "The verifier's holder.",
          "$ref": "#/$defs/Holder"
        },
        "label": {
          "description": "The verifier's label: an archetype ID or `UNCLASSIFIED`.",
          "type": "string"
        },
        "mechanism": {
          "description": "The verifier's mechanism, in words.",
          "type": "string"
        },
        "site": {
          "description": "The verifier's `file:line`, `None` when it found no site.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "finding",
        "holder",
        "mechanism",
        "label",
        "bundle",
        "agrees_site",
        "agrees_holder"
      ]
    }
  }
}
