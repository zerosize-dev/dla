{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HarnessDump",
  "description": "One JSON line of `out/<pid>.jsonl`. Only `dla_harness` and `phase` are required.",
  "type": "object",
  "properties": {
    "argv": {
      "description": "Command line of the process.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "captures": {
      "description": "Files the agent wrote for `DLA_CAPTURE` at this record.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/DumpCapture"
      }
    },
    "coverage": {
      "description": "What was exercised.",
      "anyOf": [
        {
          "$ref": "#/$defs/DumpCoverage"
        },
        {
          "type": "null"
        }
      ]
    },
    "detectors": {
      "description": "Library detector hits.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/DumpDetector"
      }
    },
    "dla_harness": {
      "description": "Dump format version ([`DUMP_VERSION`]).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "exe": {
      "description": "Executable path.",
      "type": [
        "string",
        "null"
      ]
    },
    "gc_forced": {
      "description": "True when a collection was forced before reading.",
      "type": [
        "boolean",
        "null"
      ]
    },
    "group_capped": {
      "description": "The bases of `group_counts` whose site list was cut at the agent's bound: a site missing\nfrom such a record may exist with a smaller count, so its absence is not a zero.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "group_counts": {
      "description": "Counts of every site of a grouped counter, written by each record of a driver run (the\nPython agent's `py.blocks`): base name to site to count. Unlike `groups`, the series\nbuilder chooses which sites become columns, from the records of the whole run.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "groups": {
      "description": "Grouped counters: base name to site to value.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "number",
          "format": "double"
        }
      }
    },
    "in_run": {
      "description": "How the in-run readings were taken.",
      "anyOf": [
        {
          "$ref": "#/$defs/DumpInRun"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "description": "Known limits of this dump.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      }
    },
    "line_counts": {
      "description": "How often each line the run asked about (`DLA_LINES`) was executed since the process\nstarted: `file:line` to count, a line never executed 0 (the Python agent's `line_counts`).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": "number",
        "format": "double"
      }
    },
    "modules": {
      "description": "Loaded modules the shim's frames refer to: `[{path, bias}]`."
    },
    "phase": {
      "description": "Checkpoint, exit or tick.",
      "$ref": "#/$defs/DumpPhase"
    },
    "pid": {
      "description": "Process ID.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint32",
      "minimum": 0
    },
    "probes": {
      "description": "Probe readings.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/DumpProbe"
      }
    },
    "purge": {
      "description": "The purge applied, when `DLA_PURGE` was set.",
      "anyOf": [
        {
          "$ref": "#/$defs/DumpPurge"
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_sites": {
      "description": "Unsymbolized allocation stacks from the allocator shim: stack key to\n`{live_bytes, live_blocks, allocs, frames: [{a, m, o}]}` (hex strings), kept as\nJSON because its shape belongs to the shim."
    },
    "runtime": {
      "description": "Runtime name (`jvm`, `go`, ...).",
      "type": [
        "string",
        "null"
      ]
    },
    "shim": {
      "description": "The shim's own bookkeeping counters."
    },
    "t_ms": {
      "description": "Milliseconds since the process started.",
      "type": [
        "integer",
        "null"
      ],
      "format": "uint64",
      "minimum": 0
    },
    "types": {
      "description": "Top types by count.",
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/$defs/DumpType"
      }
    },
    "values": {
      "description": "Readings (after the forced collection where the runtime has one).",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ],
        "format": "double"
      }
    },
    "values_in_run": {
      "description": "Readings taken while the workload ran (Go command mode): the floor envelope of the\nafter-collection readings, read at three quarters of the run time. Absent when no sample\nended before the exit record.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ],
        "format": "double"
      }
    },
    "values_pre_gc": {
      "description": "Readings taken just before the forced collection.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ],
        "format": "double"
      }
    },
    "x": {
      "description": "Position on the axis (units completed).",
      "type": [
        "number",
        "null"
      ],
      "format": "double"
    }
  },
  "required": [
    "dla_harness",
    "phase"
  ],
  "$defs": {
    "DetectorSite": {
      "description": "A site and how many of the things a detector hit counts it holds.",
      "type": "object",
      "properties": {
        "count": {
          "description": "Count held there.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "site": {
          "description": "`file:line`.",
          "type": "string"
        }
      },
      "required": [
        "site",
        "count"
      ]
    },
    "DumpCapture": {
      "description": "One file an agent wrote next to a dump record (`DLA_CAPTURE`).",
      "type": "object",
      "properties": {
        "bytes": {
          "description": "Size in bytes.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "error": {
          "description": "Why it was not written.",
          "type": [
            "string",
            "null"
          ]
        },
        "file": {
          "description": "File name inside `DLA_CAPTURE_DIR`.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "`heap`, `histogram`, `jfr`, `nonheap` or `alloc`.",
          "type": [
            "string",
            "null"
          ]
        },
        "ms": {
          "description": "Milliseconds the capture took.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "role": {
          "description": "What the file is (`threads.json`, `nmt summary`).",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DumpCoverage": {
      "description": "What the process exercised.",
      "type": "object",
      "properties": {
        "file": {
          "description": "Or a file holding them.",
          "type": [
            "string",
            "null"
          ]
        },
        "items": {
          "description": "The items, inline.",
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "kind": {
          "description": "`classes` or `functions`.",
          "type": [
            "string",
            "null"
          ]
        },
        "project": {
          "description": "JVM: how many distinct top-level classes of the project were loaded (classes under\n`DLA_PROJECT`, or in a package the project's sources declare).",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "sources": {
          "description": "JVM: the source file of each loaded project class, as `package/path/File.kt` (the\nclass file's `SourceFile` attribute under the package directory).",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "DumpDetector": {
      "description": "A library detector hit.",
      "type": "object",
      "properties": {
        "lib": {
          "description": "Library name.",
          "type": [
            "string",
            "null"
          ]
        },
        "site": {
          "description": "Where it was raised (for a registration warning: the site holding most listeners).",
          "type": [
            "string",
            "null"
          ]
        },
        "sites": {
          "description": "Sites that hold what the hit is about, with counts, most first.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/DetectorSite"
          }
        },
        "text": {
          "description": "The log line or message.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DumpInRun": {
      "description": "How the in-run readings of a record were taken (Go command mode).",
      "type": "object",
      "properties": {
        "end_ms": {
          "description": "Milliseconds since the process started when the sampler was stopped.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "reading_ms": {
          "description": "Milliseconds since the process started at which the reading stands (three quarters of the run).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "samples": {
          "description": "Samples that ended before the exit path started.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "spent_ms": {
          "description": "Milliseconds spent inside samples (collection, reading, profile).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "statistic": {
          "description": "The statistic the reading is: `floor-at-three-quarters`.",
          "type": [
            "string",
            "null"
          ]
        },
        "window_samples": {
          "description": "Samples that ended in the last third of the run.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        }
      }
    },
    "DumpPhase": {
      "description": "When in the process a dump line was written.",
      "oneOf": [
        {
          "description": "One round of a driver.",
          "type": "string",
          "const": "checkpoint"
        },
        {
          "description": "The end of the process.",
          "type": "string",
          "const": "exit"
        },
        {
          "description": "A periodic dump.",
          "type": "string",
          "const": "tick"
        }
      ]
    },
    "DumpProbe": {
      "description": "One probe reading.",
      "type": "object",
      "properties": {
        "bytes": {
          "description": "Estimated bytes.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "classes": {
          "description": "Classes a probed class loader defined (JVM `ClassLoader` holders only).",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "error": {
          "description": "Why it could not be read.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Probe ID (`P1`).",
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "description": "Short name.",
          "type": [
            "string",
            "null"
          ]
        },
        "path": {
          "description": "Full path of the probed thing.",
          "type": [
            "string",
            "null"
          ]
        },
        "reachable": {
          "description": "Objects reachable from it.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "size": {
          "description": "Entries in the holder.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      }
    },
    "DumpPurge": {
      "description": "A purge applied around the last reading. The Python, JVM and Go agents apply a `gc`\npurge just before the last reading (its `before` is read before the collection) and\ntheir trim-type purges (`trim`, `trim-native-heap`, `free-os-memory`) after it; the Node\nagent applies it after the last point (its `before` is that point's own post-GC reading,\nits `after` is taken after one more forced GC when `gc` is available).",
      "type": "object",
      "properties": {
        "after": {
          "description": "Values after the purge.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "default": {}
        },
        "before": {
          "description": "Values before the purge.",
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "default": {}
        },
        "kind": {
          "description": "`trim`, `gc`, `free-os-memory`, ...",
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "DumpType": {
      "description": "A type with many instances.",
      "type": "object",
      "properties": {
        "bytes": {
          "description": "Bytes they hold.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "count": {
          "description": "Live instances.",
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "name": {
          "description": "Type name.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
