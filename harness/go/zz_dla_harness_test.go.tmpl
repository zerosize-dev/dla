// Code generated for the DLA harness; not part of the project. Command mode.
//
// Placed next to a `package main` (the workload's entry package) as zz_dla_harness_test.go and run
// with:  go test -vet=off -count=1 -run '^TestDLAHarness$' [-coverprofile ... -coverpkg=./...] ./cmd/x
// TestDLAHarness sets os.Args from DLA_ARGS (a JSON array of strings), runs the workload's main(),
// then writes one `exit` record to DLA_HARNESS_OUT. Environment: DLA_HARNESS_OUT, DLA_ARGS,
// DLA_PURGE (free-os-memory|gc|none), DLA_PROJECT, DLA_TICK_MS, DLA_ITER, DLA_INRUN (off: no sampler).
//
// The exit record is written after main() returned, when state owned by locals of the workload is
// already dead. While main() runs a sampler goroutine (dlaStartSampler) forces a collection on a
// geometric schedule and reads the heap; the record then also carries `values_in_run` (the floor
// of the readings of the last third of the run: go.heap_live, go.heap_objects) and `in_run` (how
// the reading was taken), and with alloc capture the heap profile of the last sample takes the
// place of the exit-time heap profile. The base columns are unchanged.

package @@DLA_PACKAGE@@

import (
	dlabytes "bytes"
	dlajson "encoding/json"
	dlaos "os"
	dlafilepath "path/filepath"
	dlaruntime "runtime"
	dladebug "runtime/debug"
	dlametrics "runtime/metrics"
	dlapprof "runtime/pprof"
	dlastrconv "strconv"
	dlastrings "strings"
	dlasync "sync"
	dlatesting "testing"
	dlatime "time"
)

// DLA-ENGINE-BEGIN (identical in zz_dla_harness_test.go.tmpl and zz_dla_driver_test.go.tmpl)

// dlaMetric maps a runtime/metrics sample to a dump column.
type dlaMetric struct{ metric, column string }

var dlaMetrics = []dlaMetric{
	{"/gc/heap/live:bytes", "go.heap_live"},
	{"/memory/classes/heap/objects:bytes", "go.heap_objects"},
	{"/memory/classes/total:bytes", "go.total"},
	{"/memory/classes/heap/released:bytes", "go.released"},
	{"/memory/classes/heap/stacks:bytes", "go.stacks"},
	{"/sched/goroutines:goroutines", "go.goroutines"},
}

var (
	dlaStart        = dlatime.Now()
	dlaArgv         = append([]string(nil), dlaos.Args...)
	dlaMu           dlasync.Mutex
	dlaCheckpointed bool
	dlaDetectors    []map[string]any
	dlaProbeHook    func() []map[string]any // driver mode: GoVar probes read by the hook
	dlaNotes        []string
	// Command mode only (nil in driver mode, which leaves the records unchanged): the reading
	// taken while the workload ran, and the heap profile of the sample that gave it.
	dlaInRunHook    func(notes *[]string) (map[string]float64, map[string]any)
	dlaInRunProfile func() ([]byte, float64)
)

func dlaEnv(name string) string { return dlaos.Getenv(name) }

func dlaIter() *int {
	if n, err := dlastrconv.Atoi(dlaEnv("DLA_ITER")); err == nil {
		return &n
	}
	return nil
}

// dlaReadMetrics reads the runtime/metrics columns; unsupported metrics are noted once.
func dlaReadMetrics(notes *[]string) map[string]float64 {
	samples := make([]dlametrics.Sample, len(dlaMetrics))
	for i, m := range dlaMetrics {
		samples[i].Name = m.metric
	}
	dlametrics.Read(samples)
	out := make(map[string]float64, len(samples))
	for i, s := range samples {
		switch s.Value.Kind() {
		case dlametrics.KindUint64:
			out[dlaMetrics[i].column] = float64(s.Value.Uint64())
		case dlametrics.KindFloat64:
			out[dlaMetrics[i].column] = s.Value.Float64()
		default:
			*notes = append(*notes, "runtime metric unavailable: "+s.Name)
		}
	}
	return out
}

// dlaOSValues reads the process figures from /proc/self/status (Linux).
func dlaOSValues() map[string]float64 {
	out := map[string]float64{}
	data, err := dlaos.ReadFile("/proc/self/status")
	if err != nil {
		return out
	}
	keys := map[string]string{
		"VmRSS": "os.rss", "RssAnon": "os.rss_anon", "RssFile": "os.rss_file", "RssShmem": "os.rss_shmem",
		"VmSwap": "os.swap", "VmData": "os.vm_data", "VmHWM": "os.vm_hwm",
	}
	for _, line := range dlastrings.Split(string(data), "\n") {
		key, rest, ok := dlastrings.Cut(line, ":")
		if !ok {
			continue
		}
		fields := dlastrings.Fields(rest)
		if len(fields) == 0 {
			continue
		}
		n, err := dlastrconv.ParseFloat(fields[0], 64)
		if err != nil {
			continue
		}
		if col, ok := keys[key]; ok {
			out[col] = n * 1024
		} else if key == "Threads" {
			out["os.threads"] = n
		}
	}
	return out
}

func dlaMerge(dst map[string]float64, src map[string]float64) map[string]float64 {
	for k, v := range src {
		dst[k] = v
	}
	return dst
}

func dlaEvalRoot(p string) string {
	if p == "" {
		return ""
	}
	if abs, err := dlafilepath.Abs(p); err == nil {
		p = abs
	}
	if real, err := dlafilepath.EvalSymlinks(p); err == nil {
		p = real
	}
	return dlafilepath.ToSlash(p)
}

// dlaSite makes a "created by" location relative to DLA_PROJECT (and GOROOT-relative for the
// standard library); other locations keep their path.
func dlaSite(file, line string) string {
	file = dlafilepath.ToSlash(file)
	for _, root := range []string{dlaEnv("DLA_PROJECT"), dlaEvalRoot(dlaEnv("DLA_PROJECT"))} {
		root = dlastrings.TrimRight(dlafilepath.ToSlash(root), "/")
		if root != "" && dlastrings.HasPrefix(file, root+"/") {
			return file[len(root)+1:] + ":" + line
		}
	}
	if goroot := dlastrings.TrimRight(dlafilepath.ToSlash(dlaruntime.GOROOT()), "/"); goroot != "" && dlastrings.HasPrefix(file, goroot+"/") {
		return "$GOROOT/" + file[len(goroot)+1:] + ":" + line
	}
	return file + ":" + line
}

// dlaGoroutines parses the goroutine profile (debug=2) into counts per "created by" site. The
// harness's own ticker and sampler goroutines and those created by the testing package or the
// runtime are left out; goroutines without a creator (main) are not grouped.
func dlaGoroutines() map[string]float64 {
	groups := map[string]float64{}
	profile := dlapprof.Lookup("goroutine")
	if profile == nil {
		return groups
	}
	var buf dlabytes.Buffer
	if err := profile.WriteTo(&buf, 2); err != nil {
		return groups
	}
	for _, block := range dlastrings.Split(buf.String(), "\n\n") {
		lines := dlastrings.Split(dlastrings.TrimSpace(block), "\n")
		creator := -1
		for i, line := range lines {
			if dlastrings.HasPrefix(line, "created by ") {
				creator = i
			}
		}
		if creator < 0 || creator+1 >= len(lines) {
			continue
		}
		fn, _, _ := dlastrings.Cut(dlastrings.TrimPrefix(lines[creator], "created by "), " in goroutine ")
		if dlastrings.HasPrefix(fn, "testing.") || dlastrings.HasPrefix(fn, "runtime.") || dlastrings.Contains(fn, ".dlaStartTicker") || dlastrings.Contains(fn, ".dlaStartSampler") {
			continue
		}
		loc := dlastrings.TrimSpace(lines[creator+1])
		if at := dlastrings.LastIndex(loc, " +0x"); at > 0 {
			loc = loc[:at]
		}
		cut := dlastrings.LastIndex(loc, ":")
		if cut <= 0 {
			continue
		}
		file, line := loc[:cut], loc[cut+1:]
		groups[dlaSite(file, line)]++
	}
	return groups
}

// dlaPurgeFigures picks the figures a purge is judged by out of a value set.
func dlaPurgeFigures(values map[string]float64) map[string]float64 {
	out := map[string]float64{}
	for _, k := range []string{"go.released", "go.total", "go.heap_objects", "os.rss", "os.rss_anon"} {
		if v, ok := values[k]; ok {
			out[k] = v
		}
	}
	return out
}

func dlaPurgeSnapshot() map[string]float64 {
	var notes []string
	return dlaPurgeFigures(dlaMerge(dlaReadMetrics(&notes), dlaOSValues()))
}

// dlaBuild assembles one record. A tick record is cheap: no collection, no probes.
func dlaBuild(phase string, x *int, last bool) map[string]any {
	var notes []string
	tick := phase == "tick"
	rec := map[string]any{
		"dla_harness": 1, "phase": phase, "pid": dlaos.Getpid(), "argv": dlaArgv, "runtime": "go",
		"t_ms": dlatime.Since(dlaStart).Milliseconds(), "gc_forced": !tick,
	}
	if exe, err := dlaos.Executable(); err == nil {
		rec["exe"] = exe
	}
	if x != nil {
		rec["x"] = *x
	}
	var pre map[string]float64
	if !tick {
		m := dlaReadMetrics(&notes)
		pre = map[string]float64{}
		for _, k := range []string{"go.heap_objects", "go.total", "go.goroutines"} {
			if v, ok := m[k]; ok {
				pre[k] = v
			}
		}
		if v, ok := dlaOSValues()["os.rss"]; ok {
			pre["os.rss"] = v
		}
		dlaruntime.GC()
		dlaruntime.GC()
	}
	values := dlaMerge(dlaReadMetrics(&notes), dlaOSValues())
	rec["values"] = values
	if pre != nil {
		rec["values_pre_gc"] = pre
	}
	if dlaInRunHook != nil && !tick {
		inRun, info := dlaInRunHook(&notes)
		if len(inRun) > 0 {
			rec["values_in_run"] = inRun
		}
		if info != nil {
			rec["in_run"] = info
		}
	}
	rec["groups"] = map[string]any{"go.goroutines": dlaGoroutines()}
	if purge := dlaEnv("DLA_PURGE"); last && !tick && purge != "" && purge != "none" {
		switch purge {
		case "free-os-memory":
			// before = the figures read right after the forced collections above
			before := dlaPurgeFigures(values)
			dladebug.FreeOSMemory()
			rec["purge"] = map[string]any{"kind": purge, "before": before, "after": dlaPurgeSnapshot()}
		case "gc":
			rec["purge"] = map[string]any{"kind": purge, "before": pre, "after": dlaPurgeFigures(values)}
		default:
			notes = append(notes, "purge '"+purge+"' is not supported by the go agent (free-os-memory, gc)")
			rec["purge"] = map[string]any{"kind": purge}
		}
	}
	if dlaProbeHook != nil && !tick {
		rec["probes"] = dlaProbeHook()
	}
	if len(dlaDetectors) > 0 && !tick {
		rec["detectors"] = dlaDetectors
	}
	notes = append(notes, dlaNotes...)
	if tick {
		notes = append(notes, "tick record: no forced collection")
	}
	if !tick {
		if caps := dlaCapture(phase, &notes); len(caps) > 0 {
			rec["captures"] = caps
		}
	}
	rec["go_version"] = dlaruntime.Version()
	rec["limitations"] = dlaUnique(notes)
	return rec
}

func dlaUnique(in []string) []string {
	seen := map[string]bool{}
	out := []string{}
	for _, s := range in {
		if !seen[s] {
			seen[s] = true
			out = append(out, s)
		}
	}
	return out
}

// dlaDump appends one record to DLA_HARNESS_OUT. It never panics.
func dlaDump(phase string, x *int, last bool) {
	out := dlaEnv("DLA_HARNESS_OUT")
	if out == "" {
		return
	}
	dlaMu.Lock()
	defer dlaMu.Unlock()
	defer func() { _ = recover() }()
	line, err := dlajson.Marshal(dlaBuild(phase, x, last))
	if err != nil {
		line, _ = dlajson.Marshal(map[string]any{"dla_harness": 1, "phase": phase, "runtime": "go", "limitations": []string{"dump failed: " + err.Error()}})
	}
	_ = dlaos.MkdirAll(dlafilepath.Dir(out), 0o755)
	f, err := dlaos.OpenFile(out, dlaos.O_APPEND|dlaos.O_CREATE|dlaos.O_WRONLY, 0o644)
	if err != nil {
		return
	}
	_, _ = f.Write(append(line, '\n'))
	_ = f.Close()
}

// dlaStartTicker writes a tick record every DLA_TICK_MS (when set) and returns a stop function
// that waits for the ticker goroutine to end.
func dlaStartTicker() func() {
	ms, err := dlastrconv.Atoi(dlaEnv("DLA_TICK_MS"))
	if err != nil || ms <= 0 {
		return func() {}
	}
	done, stopped := make(chan struct{}), make(chan struct{})
	go func() {
		defer close(stopped)
		t := dlatime.NewTicker(dlatime.Duration(ms) * dlatime.Millisecond)
		defer t.Stop()
		for {
			select {
			case <-done:
				return
			case <-t.C:
				dlaDump("tick", nil, false)
			}
		}
	}()
	var once dlasync.Once
	return func() { once.Do(func() { close(done); <-stopped }) }
}

// ---- raw captures (DLA_CAPTURE): heap profile, goroutine profiles, goroutineleak profile
//
// Files go to DLA_CAPTURE_DIR/<pid>/ and are listed in the "captures" array of the record that
// triggered them (kind, file, role, bytes, ms, error). DLA_CAPTURE is a comma list of alloc and
// nonheap (heap, histogram and jfr are JVM and Node captures):
//
//	alloc    go-<n>.heap.pb.gz          pprof.Lookup("heap") after runtime.GC(): in-use bytes by stack
//	                                    (command mode: the profile of the last in-run sample, taken
//	                                    while the workload ran, when there is one)
//	nonheap  go-<n>.goroutine.pb.gz     pprof.Lookup("goroutine") protobuf
//	         go-<n>.goroutine.txt       the same profile at debug=2 (the "created by" frames)
//	         go-<n>.goroutineleak.txt   pprof.Lookup("goroutineleak") at debug=2: goroutines the
//	                                    runtime proved blocked forever (Go 1.27, or 1.26 with
//	                                    GOEXPERIMENT=goroutineleakprofile)
//
// Driver mode captures at the checkpoints dumpHere picks (DLA_CAPTURE_DUMPS, default 4: the end of
// the warm-up, the last round and evenly spaced rounds between); command mode captures at exit.
// DLA_GO_LEAK_ONLY=1 writes only the goroutineleak file (the separate leak pass on a newer
// toolchain). runtime.MemProfileRate is set before the workload when alloc is asked for
// (DLA_MEMPROFILE_RATE, default 4096). Nothing here fails the run: a capture that cannot be written
// becomes an entry with "error".

const (
	dlaDefaultMemProfileRate = 4096
	dlaGoroutineTextCap      = 200000 // goroutines above which the debug=2 text is not written
)

var (
	dlaCaptureKinds  = dlaParseKinds(dlaEnv("DLA_CAPTURE"))
	dlaMemRateSet    = dlaSetMemProfileRate()
	dlaCaptureSeq    int
	dlaCheckpointSeq int
	dlaLeakNoted     bool
)

func dlaParseKinds(v string) map[string]bool {
	out := map[string]bool{}
	for _, part := range dlastrings.Split(v, ",") {
		if k := dlastrings.ToLower(dlastrings.TrimSpace(part)); k != "" {
			out[k] = true
		}
	}
	return out
}

// dlaSetMemProfileRate samples allocations finely when the run asks for allocation profiles. It
// runs as a package variable initializer, before the test or the workload starts.
func dlaSetMemProfileRate() bool {
	if dlaEnv("DLA_CAPTURE_DIR") == "" || !dlaCaptureKinds["alloc"] || dlaEnv("DLA_GO_LEAK_ONLY") != "" {
		return false
	}
	rate := dlaDefaultMemProfileRate
	if n, err := dlastrconv.Atoi(dlaEnv("DLA_MEMPROFILE_RATE")); err == nil && n > 0 {
		rate = n
	}
	dlaruntime.MemProfileRate = rate
	return true
}

func dlaIntEnv0(name string, def int) int {
	if n, err := dlastrconv.Atoi(dlaEnv(name)); err == nil && n >= 0 {
		return n
	}
	return def
}

// dlaDumpHere says whether the checkpoint with this 1-based number gets the heavy captures (the
// same rule as the other agents).
func dlaDumpHere(seq, warmup, rounds, dumps int) bool {
	total := warmup + rounds
	if total <= 0 || total <= dumps {
		return true
	}
	first := warmup
	if first < 1 {
		first = 1
	}
	if seq == first || seq == total {
		return true
	}
	interior := dumps - 2
	if interior <= 0 || seq < first || seq > total {
		return false
	}
	for j := 1; j <= interior; j++ {
		if seq == first+int(float64(total-first)*float64(j)/float64(interior+1)+0.5) {
			return true
		}
	}
	return false
}

// dlaCaptureHere counts checkpoints and decides whether this record captures.
func dlaCaptureHere(phase string) bool {
	switch phase {
	case "tick":
		return false
	case "checkpoint":
		dlaCheckpointSeq++
		return dlaDumpHere(dlaCheckpointSeq, dlaIntEnv0("DLA_WARMUP", 0), dlaIntEnv0("DLA_ROUNDS", 0), dlaIntEnv0("DLA_CAPTURE_DUMPS", 4))
	}
	return true
}

// dlaWriteProfile writes one named profile to dir/file and returns its capture entry.
func dlaWriteProfile(dir, file, kind, role, name string, debug int) map[string]any {
	entry := map[string]any{"kind": kind, "role": role}
	p := dlapprof.Lookup(name)
	if p == nil {
		entry["error"] = "the " + name + " profile is not available in " + dlaruntime.Version()
		return entry
	}
	t0 := dlatime.Now()
	tmp := dlafilepath.Join(dir, file+".tmp")
	f, err := dlaos.Create(tmp)
	if err != nil {
		entry["error"] = err.Error()
		return entry
	}
	werr := p.WriteTo(f, debug)
	cerr := f.Close()
	if werr == nil {
		werr = cerr
	}
	if werr == nil {
		werr = dlaos.Rename(tmp, dlafilepath.Join(dir, file))
	}
	if werr != nil {
		_ = dlaos.Remove(tmp)
		entry["error"] = werr.Error()
		return entry
	}
	entry["file"] = file
	if st, err := dlaos.Stat(dlafilepath.Join(dir, file)); err == nil {
		entry["bytes"] = st.Size()
	}
	entry["ms"] = dlatime.Since(t0).Milliseconds()
	return entry
}

// dlaWriteBytes writes profile bytes taken earlier to dir/file and returns their capture entry.
func dlaWriteBytes(dir, file, kind, role string, b []byte) map[string]any {
	entry := map[string]any{"kind": kind, "role": role}
	t0 := dlatime.Now()
	tmp := dlafilepath.Join(dir, file+".tmp")
	werr := dlaos.WriteFile(tmp, b, 0o644)
	if werr == nil {
		werr = dlaos.Rename(tmp, dlafilepath.Join(dir, file))
	}
	if werr != nil {
		_ = dlaos.Remove(tmp)
		entry["error"] = werr.Error()
		return entry
	}
	entry["file"] = file
	entry["bytes"] = len(b)
	entry["ms"] = dlatime.Since(t0).Milliseconds()
	return entry
}

// dlaCapture writes the profiles asked for at this record and returns its "captures" entries.
// The caller has just run runtime.GC() twice, so the heap profile is current. In command mode the
// heap profile of the last in-run sample is written instead when there is one (one heap profile
// per point: the exit-time profile of a finished workload holds only runtime stacks).
func dlaCapture(phase string, notes *[]string) []map[string]any {
	root := dlaEnv("DLA_CAPTURE_DIR")
	if root == "" || len(dlaCaptureKinds) == 0 || !dlaCaptureHere(phase) {
		return nil
	}
	dir := dlafilepath.Join(root, dlastrconv.Itoa(dlaos.Getpid()))
	if err := dlaos.MkdirAll(dir, 0o755); err != nil {
		return []map[string]any{{"kind": "nonheap", "error": "capture directory unusable: " + err.Error()}}
	}
	dlaCaptureSeq++
	n := dlastrconv.Itoa(dlaCaptureSeq)
	leakOnly := dlaEnv("DLA_GO_LEAK_ONLY") != ""
	var out []map[string]any
	if dlaCaptureKinds["alloc"] && !leakOnly {
		file := "go-" + n + ".heap.pb.gz"
		var inRun []byte
		var inRunMs float64
		if dlaInRunProfile != nil {
			inRun, inRunMs = dlaInRunProfile()
		}
		if len(inRun) > 0 {
			role := "heap profile (in-use bytes by stack, taken in the run at " + dlastrconv.FormatFloat(inRunMs, 'f', 1, 64) + " ms, after GC)"
			out = append(out, dlaWriteBytes(dir, file, "alloc", role, inRun))
		} else {
			if dlaInRunProfile != nil {
				*notes = append(*notes, "go command mode: no heap profile was taken in the run; the exit profile is written (state owned by locals of the workload is not in it)")
			}
			out = append(out, dlaWriteProfile(dir, file, "alloc", "heap profile (in-use bytes by stack, after GC)", "heap", 0))
		}
	}
	if dlaCaptureKinds["nonheap"] {
		if !leakOnly {
			out = append(out, dlaWriteProfile(dir, "go-"+n+".goroutine.pb.gz", "nonheap", "goroutine profile (protobuf)", "goroutine", 0))
			if p := dlapprof.Lookup("goroutine"); p != nil && p.Count() > dlaGoroutineTextCap {
				out = append(out, map[string]any{"kind": "nonheap", "error": "more than " + dlastrconv.Itoa(dlaGoroutineTextCap) + " goroutines: the debug=2 text was not written"})
			} else {
				out = append(out, dlaWriteProfile(dir, "go-"+n+".goroutine.txt", "nonheap", "goroutine dump (debug=2, created-by frames)", "goroutine", 2))
			}
		}
		if dlapprof.Lookup("goroutineleak") != nil {
			out = append(out, dlaWriteProfile(dir, "go-"+n+".goroutineleak.txt", "nonheap", "goroutineleak profile (debug=2)", "goroutineleak", 2))
		} else if !dlaLeakNoted {
			// Not an error of this run: dla harness run decides how to reach the profile.
			dlaLeakNoted = true
			dlaNotes = append(dlaNotes, "the goroutineleak profile is not available in "+dlaruntime.Version())
		}
	}
	return out
}

// DLA-ENGINE-END

// ---- the sampler: readings taken while main() runs (command mode only)
//
// The base columns are read after main() returned, when whatever the workload kept in locals is
// dead; a program whose state lives in a function of main (a request loop filling a local index)
// reads flat there although its heap grew while it ran. The sampler forces one runtime.GC() per
// sample on a geometric schedule, reads the heap, and the exit record reports the FLOOR of the
// readings of the last third of the run as go.heap_live.in_run / go.heap_objects.in_run.
//
//   - Geometric schedule: a short point still gets samples (2 ms, then each one 15 % later than
//     the end of the last), and the number of samples grows with the logarithm of the run, so a
//     longer run does not read higher by taking more samples.
//   - Time budget: a sample starts only when the time spent inside samples so far is at most a
//     quarter of the elapsed time. Measured cost: +2 to +3 % of the run time on runs of 8 to 100
//     seconds, +16 % on a one-second run of a pointer-heavy heap (60 MB of small objects).
//   - Statistic: the floor envelope of the readings (the lowest reading at or after each sample), read at
//     three quarters of the run time by interpolation between the samples around that time. The
//     maximum of noisy readings grows with their number and the last reading carries the whole
//     transient of a workload with batches in flight; the floor does not rise on a flat workload and
//     is a lower bound of the live heap while it ran. The reading is taken at one share of the run, not
//     at the sample nearest to it: the geometric schedule puts the last sample at a different share of
//     each run (63 to 96 % in measured runs, 40 % under load), and a series over n whose points stand
//     at different shares of their work is not linear in n. When no sample ended after that time the
//     floor of the last four samples is continued to it (a note says so).
//   - A sample that ends after main() returned is dropped (it would read a dead heap): the exit
//     path sets the finished flag under the mutex, then waits for the goroutine.
//   - DLA_INRUN=off switches the sampler off.
const (
	dlaInRunFirstMs = 2.0       // first sample, ms since process start
	dlaInRunRatio   = 1.15      // next sample at ratio x the end of the last
	dlaInRunBudget  = 0.25      // share of the elapsed time samples may take
	dlaInRunWindow  = 2.0 / 3.0 // only used to count the samples of the last third of the run (window_samples)
	dlaInRunAt      = 0.75      // the floor envelope of the samples is read at this share of the run time
)

type dlaSample struct{ endMs, live, objects float64 }

var (
	dlaSampleMu      dlasync.Mutex
	dlaSamples       []dlaSample
	dlaSampleProf    []byte
	dlaSampleProfMs  float64
	dlaSampleSpent   float64
	dlaSampleEndMs   float64
	dlaSampleNotes   []string
	dlaSamplerOff    bool
	dlaSampleStopped bool
)

func dlaSinceMs() float64 { return float64(dlatime.Since(dlaStart).Microseconds()) / 1000 }

// dlaStartSampler starts the sampler goroutine and returns a stop function that ends it and waits
// for it. Nothing a sample does may fail the workload.
func dlaStartSampler() func() {
	if dlaEnv("DLA_INRUN") == "off" {
		dlaSamplerOff = true
		return func() {}
	}
	withProfile := dlaMemRateSet
	done, stopped := make(chan struct{}), make(chan struct{})
	go func() {
		defer close(stopped)
		defer func() { _ = recover() }()
		next := dlaInRunFirstMs
		for {
			if wait := next - dlaSinceMs(); wait > 0 {
				timer := dlatime.NewTimer(dlatime.Duration(wait * float64(dlatime.Millisecond)))
				select {
				case <-done:
					timer.Stop()
					return
				case <-timer.C:
				}
			}
			select {
			case <-done:
				return
			default:
			}
			began := dlaSinceMs()
			dlaruntime.GC()
			var notes []string
			m := dlaReadMetrics(&notes)
			var prof []byte
			if withProfile {
				if p := dlapprof.Lookup("heap"); p != nil {
					var buf dlabytes.Buffer
					if err := p.WriteTo(&buf, 0); err == nil {
						prof = buf.Bytes()
					}
				}
			}
			end := dlaSinceMs()
			dlaSampleMu.Lock()
			if dlaSampleStopped {
				dlaSampleMu.Unlock()
				return
			}
			dlaSampleSpent += end - began
			live, ok := m["go.heap_live"]
			if !ok {
				dlaSampleNotes = append(dlaSampleNotes, notes...)
				dlaSampleMu.Unlock()
				return
			}
			dlaSamples = append(dlaSamples, dlaSample{endMs: end, live: live, objects: m["go.heap_objects"]})
			if prof != nil {
				dlaSampleProf, dlaSampleProfMs = prof, end
			}
			spent := dlaSampleSpent
			dlaSampleMu.Unlock()
			next = end * dlaInRunRatio
			if floor := spent / dlaInRunBudget; floor > next {
				next = floor
			}
		}
	}()
	var once dlasync.Once
	return func() {
		once.Do(func() {
			dlaSampleMu.Lock()
			dlaSampleStopped = true
			dlaSampleEndMs = dlaSinceMs()
			dlaSampleMu.Unlock()
			close(done)
			<-stopped
		})
	}
}

// dlaEnvelopeAt is the floor envelope of one metric at time t: the readings are replaced by the lowest
// reading at or after each of them (so a transient high is ignored and the curve never falls), and the
// envelope is read at t by linear interpolation between the samples that bracket it. Before the first
// sample it is the first reading. After the last sample it continues the slope of the envelope over
// its last four points (never below zero) when t is at most four times the last sample's time, and
// else stays at the last reading. The second result says which: "interpolated", "extrapolated" or "last".
func dlaEnvelopeAt(ts, ys []float64, t float64) (float64, string) {
	n := len(ts)
	env := make([]float64, n)
	low := ys[n-1]
	for i := n - 1; i >= 0; i-- {
		if ys[i] < low {
			low = ys[i]
		}
		env[i] = low
	}
	if t <= ts[0] {
		return env[0], "interpolated"
	}
	for i := 1; i < n; i++ {
		if t <= ts[i] {
			f := (t - ts[i-1]) / (ts[i] - ts[i-1])
			return env[i-1] + f*(env[i]-env[i-1]), "interpolated"
		}
	}
	from := n - 4
	if from < 0 {
		from = 0
	}
	if n-1 == from || ts[n-1] <= 0 || t > 4*ts[n-1] || ts[n-1] == ts[from] {
		return env[n-1], "last"
	}
	slope := (env[n-1] - env[from]) / (ts[n-1] - ts[from])
	if slope < 0 {
		slope = 0
	}
	return env[n-1] + slope*(t-ts[n-1]), "extrapolated"
}

// dlaInRunReading is the reading of the exit record: the floor envelope of the samples' go.heap_live and
// go.heap_objects, read at three quarters of the run (dlaInRunAt), with the figures that say how it
// was taken. A sample is taken wherever the geometric schedule falls, so its own time is a different
// share of each run; reading the envelope at one share of the run puts every point of a series at
// the same share of its work, which is what a series over n needs.
func dlaInRunReading(notes *[]string) (map[string]float64, map[string]any) {
	dlaSampleMu.Lock()
	defer dlaSampleMu.Unlock()
	*notes = append(*notes, dlaSampleNotes...)
	if len(dlaSamples) == 0 {
		if dlaSamplerOff {
			*notes = append(*notes, "go command mode: no in-run reading (the sampler was switched off with DLA_INRUN=off); the in-run columns have no value at this point")
		} else {
			*notes = append(*notes, "go command mode: no in-run reading (the workload ended before the first sample finished, 2 ms; or the sampler was off); the in-run columns have no value at this point")
		}
		return nil, nil
	}
	end := dlaSampleEndMs
	at := dlaInRunAt * end
	ts := make([]float64, len(dlaSamples))
	live := make([]float64, len(dlaSamples))
	objects := make([]float64, len(dlaSamples))
	for i, s := range dlaSamples {
		ts[i], live[i], objects[i] = s.endMs, s.live, s.objects
	}
	l, how := dlaEnvelopeAt(ts, live, at)
	o, _ := dlaEnvelopeAt(ts, objects, at)
	vals := map[string]float64{"go.heap_live": l, "go.heap_objects": o}
	window := 0
	for _, t := range ts {
		if t >= dlaInRunWindow*end {
			window++
		}
	}
	keep := len(ts)
	if keep > 48 {
		keep = 48
	}
	info := map[string]any{
		"samples": len(dlaSamples), "window_samples": window, "reading_ms": at,
		"end_ms": end, "spent_ms": dlaSampleSpent, "statistic": "floor-at-three-quarters", "how": how,
		"last_sample_ms": ts[len(ts)-1], "sample_ms": ts[len(ts)-keep:], "sample_live": live[len(live)-keep:],
	}
	switch how {
	case "extrapolated":
		*notes = append(*notes, "go command mode: no sample ended after "+dlastrconv.FormatFloat(at, 'f', 0, 64)+" ms of a "+dlastrconv.FormatFloat(end, 'f', 0, 64)+" ms run (the last ended at "+dlastrconv.FormatFloat(ts[len(ts)-1], 'f', 0, 64)+" ms, "+dlastrconv.Itoa(len(dlaSamples))+" samples; the time budget of the sampler allows few collections of a heap this size): the in-run reading continues the floor of the last samples to that time")
	case "last":
		*notes = append(*notes, "go command mode: no sample ended near "+dlastrconv.FormatFloat(at, 'f', 0, 64)+" ms of a "+dlastrconv.FormatFloat(end, 'f', 0, 64)+" ms run (the last ended at "+dlastrconv.FormatFloat(ts[len(ts)-1], 'f', 0, 64)+" ms, "+dlastrconv.Itoa(len(dlaSamples))+" samples): the in-run reading is the last one and understates the state at that time")
	}
	*notes = append(*notes, "go.*.in_run: the floor (the lowest reading at or after each sample) of the after-collection readings taken while the workload ran, read at three quarters of the run time, a lower bound of the live heap while it ran; the base go.* columns are read after main returned")
	return vals, info
}

// dlaInRunProfileBytes is the heap profile of the newest sample and the time it was taken.
func dlaInRunProfileBytes() ([]byte, float64) {
	dlaSampleMu.Lock()
	defer dlaSampleMu.Unlock()
	return dlaSampleProf, dlaSampleProfMs
}

// TestDLAHarness runs main() with the workload's arguments and dumps the measurements.
func TestDLAHarness(t *dlatesting.T) {
	var args []string
	if raw := dlaEnv("DLA_ARGS"); raw != "" {
		if err := dlajson.Unmarshal([]byte(raw), &args); err != nil {
			t.Fatalf("DLA_ARGS must be a JSON array of strings: %v", err)
		}
	}
	stop := dlaStartTicker()
	stopSampler := dlaStartSampler()
	dlaInRunHook, dlaInRunProfile = dlaInRunReading, dlaInRunProfileBytes
	dlaos.Args = append([]string{dlaArgv[0]}, args...)
	defer func() {
		rec := recover()
		stopSampler()
		stop()
		if s, ok := rec.(string); ok && dlastrings.Contains(s, "os.Exit(0)") {
			// main ended with os.Exit(0), which the testing package turns into a panic
			dlaNotes = append(dlaNotes, "main called os.Exit(0); treated as a normal end")
			rec = nil
		}
		dlaDump("exit", dlaIter(), true)
		if rec != nil {
			panic(rec)
		}
	}()
	main()
}
