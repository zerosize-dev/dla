// dlaProbes reports package variables for the GoVar probes of probes.json: one record per variable.
func dlaProbes() []map[string]any {
	// DLA-HOOK probes: return one dlaProbe(id, name, path, size) per probed package variable (id = the probe id from probes.json, path = "<package dir>.<name>", size = len(...) of the map/slice/chan or the entry count); leave the empty list when there are none
	return nil
}

// dlaProbe builds one probe record; size is the number of entries the variable holds.
func dlaProbe(id, name, path string, size int) map[string]any {
	return map[string]any{"id": id, "name": name, "path": path, "size": size, "reachable": nil, "bytes": nil, "error": nil}
}

// TestDLADriver runs warm-up and measured rounds and writes a checkpoint after each.
func TestDLADriver(t *dlatesting.T) {
	dlaT = t
	step := dlaIntEnv("DLA_STEP", dlaDefaultStep)
	warmup := dlaIntEnv("DLA_WARMUP", dlaDefaultWarmup)
	rounds := dlaIntEnv("DLA_ROUNDS", dlaDefaultRounds)
	repeat := dlaIntEnv("DLA_REPEAT", dlaDefaultRepeat)
	repeated := dlaEnv("DLA_KEY_MODE") == "repeated"
	stop := dlaStartTicker()
	defer stop()
	dlaSetup()
	dlaProbeHook = dlaProbes
	total := warmup + rounds
	done := 0
	for round := 1; round <= total; round++ {
		for n := 0; n < step; n++ {
			done++
			key := done
			if repeated {
				key = done % repeat
			}
			dlaUnit(done, key)
		}
		last := round == total
		if last {
			stop()
			if dlaGoleakCheck != nil {
				if report := dlaGoleakCheck(); report != "" {
					if len(report) > 2000 {
						report = report[:2000]
					}
					dlaDetectors = append(dlaDetectors, map[string]any{"lib": "goleak", "text": report, "site": nil})
				}
			}
		}
		x := done
		dlaDump("checkpoint", &x, last)
	}
}
