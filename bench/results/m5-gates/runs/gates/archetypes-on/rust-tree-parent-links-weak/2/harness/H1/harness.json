{
  "schema_version": 1,
  "id": "H1",
  "runtime": "rust",
  "mode": "command",
  "workload": "rust:main:src/main.rs",
  "scratch": "harness/H1/work",
  "build": {
    "argv": [
      "cargo",
      "build",
      "--release",
      "--bin",
      "outline-service"
    ],
    "cwd": ".",
    "env": [
      [
        "CARGO_PROFILE_RELEASE_DEBUG",
        "line-tables-only"
      ],
      [
        "CARGO_TARGET_DIR",
        "/root/.cache/dla-bench/m5-gates/gates/archetypes-on/rust-tree-parent-links-weak/2/project/.dla/20261109-203009-89a5/harness/H1/work/target"
      ]
    ]
  },
  "run": {
    "argv": [
      "/root/.cache/dla-bench/m5-gates/gates/archetypes-on/rust-tree-parent-links-weak/2/project/.dla/20261109-203009-89a5/harness/H1/work/target/release/outline-service",
      "--iterations",
      "{n}"
    ],
    "cwd": ".",
    "env": [
      [
        "LD_PRELOAD",
        "/root/.cache/dla-bench/m5-gates/gates/archetypes-on/rust-tree-parent-links-weak/2/project/.dla/20261109-203009-89a5/harness/H1/agent/libdlashim.so"
      ]
    ]
  },
  "iter_arg": "--iterations {n}",
  "warmup": 1,
  "iterations": 8,
  "step": 220,
  "key_modes": [
    "native"
  ],
  "probes": [],
  "agent": "alloc-shim",
  "detectors": [],
  "tools": [],
  "gaps": [
    "scratch copy: 23 path(s) not copied (not a regular file)"
  ],
  "timeout_secs": 300
}
