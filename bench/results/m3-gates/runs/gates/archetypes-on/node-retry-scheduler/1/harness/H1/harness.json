{
  "schema_version": 1,
  "id": "H1",
  "runtime": "node",
  "mode": "command",
  "workload": "node:script:package.json:load",
  "scratch": "harness/H1/work",
  "run": {
    "argv": [
      "node",
      "load.js",
      "--iterations",
      "{n}"
    ],
    "cwd": ".",
    "env": [
      [
        "NODE_OPTIONS",
        "--require /tmp/dla-bench/m3-gates/gates/archetypes-on/node-retry-scheduler/1/project/.dla/20261108-123115-0295/harness/H1/agent/dla-preload.js"
      ],
      [
        "NODE_V8_COVERAGE",
        "{cov}"
      ]
    ]
  },
  "iter_arg": "--iterations {n}",
  "warmup": 1,
  "iterations": 8,
  "step": 440,
  "key_modes": [
    "native"
  ],
  "probes": [
    {
      "id": "P1",
      "target": {
        "kind": "node-module",
        "file": "src/pending.js"
      }
    },
    {
      "id": "P2",
      "target": {
        "kind": "node-module",
        "file": "src/scheduler.js"
      }
    }
  ],
  "agent": "node-preload",
  "detectors": [
    "MaxListenersExceededWarning"
  ],
  "tools": [],
  "gaps": [
    "scratch copy: 23 path(s) not copied (not a regular file)"
  ],
  "timeout_secs": 300
}
