{
  "schema_version": 1,
  "id": "H1",
  "runtime": "go",
  "mode": "command",
  "workload": "go:main:.:./cmd/notifyd",
  "scratch": "harness/H1/work",
  "build": {
    "argv": [
      "go",
      "test",
      "-vet=off",
      "-count=1",
      "-run",
      "^$",
      "-coverpkg=./...",
      "./cmd/notifyd"
    ],
    "cwd": ".",
    "env": []
  },
  "run": {
    "argv": [
      "go",
      "test",
      "-vet=off",
      "-count=1",
      "-timeout",
      "0",
      "-run",
      "^TestDLAHarness$",
      "-coverprofile",
      "{cov}/{label}.out",
      "-coverpkg=./...",
      "./cmd/notifyd"
    ],
    "cwd": ".",
    "env": [
      [
        "DLA_ARGS",
        "[\"-n\",\"{n}\"]"
      ]
    ]
  },
  "iter_arg": "-n {n}",
  "warmup": 1,
  "iterations": 8,
  "step": 440,
  "key_modes": [
    "native"
  ],
  "probes": [],
  "agent": "go-test-wrapper",
  "detectors": [],
  "tools": [],
  "gaps": [
    "scratch copy: 23 path(s) not copied (not a regular file)",
    "go command mode has no package-variable probes: growth shows in the goroutine groups and runtime totals (use --driver for GoVar probes)"
  ],
  "timeout_secs": 300
}
