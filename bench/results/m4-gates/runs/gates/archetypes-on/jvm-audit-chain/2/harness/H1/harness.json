{
  "schema_version": 1,
  "id": "H1",
  "runtime": "jvm",
  "mode": "command",
  "workload": "jvm:main:build.sh:run",
  "scratch": "harness/H1/work",
  "run": {
    "argv": [
      "sh",
      "./build.sh",
      "run",
      "{n}"
    ],
    "cwd": ".",
    "env": [
      [
        "JAVA_TOOL_OPTIONS",
        "-javaagent:/root/.cache/dla-bench/m4-gates/gates/archetypes-on/jvm-audit-chain/2/project/.dla/20261108-200609-bc6f/harness/H1/agent/dla-agent.jar -XX:NativeMemoryTracking=summary"
      ]
    ]
  },
  "iter_arg": "{n}",
  "warmup": 1,
  "iterations": 8,
  "step": 1110,
  "key_modes": [
    "native"
  ],
  "probes": [
    {
      "id": "P1",
      "target": {
        "kind": "jvm-class",
        "class": "gateway.Gateway"
      }
    },
    {
      "id": "P2",
      "target": {
        "kind": "jvm-class",
        "class": "gateway.Ledger"
      }
    },
    {
      "id": "P3",
      "target": {
        "kind": "jvm-class",
        "class": "gateway.RequestContext"
      }
    }
  ],
  "agent": "jvm-agent",
  "detectors": [],
  "tools": [],
  "gaps": [
    "scratch copy: 23 path(s) not copied (not a regular file)",
    "note: the build script compiles and runs the unit tests again at every point; the measured program is the last JVM it starts"
  ],
  "timeout_secs": 300
}
