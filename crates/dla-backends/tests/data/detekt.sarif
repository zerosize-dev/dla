     "message": {
      "text": "You should always catch and re-throw CancellationExceptions in a try block from a suspending function. The exception should be re-thrown immediately after catching it - it's intended to completely kill any running jobs in your coroutine."
     },
     "partialFingerprints": {
      "signature/v1": "c30beb1f6a17677cacd3604f7cab5de22e94e42a"
     },
     "ruleId": "detekt.coroutines.SuspendFunSwallowedCancellation"
    },
